    "paragraphs": [
      "2025\u5e74\uff0c\u67d0\u7701\u6709\u6548\u671f\u5185\u4e13\u7cbe\u7279\u65b0\u4f01\u4e1a[[se_total|15000\u5bb6]]\uff0c\u540c\u6bd4\u589e\u957f[[se_total_r|20%]]\uff1b\u5b9e\u73b0\u8425\u4e1a\u6536\u5165[[se_revenue|10000\u4ebf\u5143]]\uff0c\u540c\u6bd4\u589e\u957f[[se_revenue_r|23.5%]]\u3002\u5176\u4e2d\uff0c\u73e0\u4e09\u89d2\u4f01\u4e1a[[se_prd|9000\u5bb6]]\u3001\u589e\u957f12.5%\uff0c\u8425\u4e1a\u6536\u5165[[se_prd_rev|7200\u4ebf\u5143]]\u3001\u589e\u957f[[se_prd_rev_r|20%]]\uff1b\u4e1c\u90e8\u4f01\u4e1a[[se_east|2400\u5bb6]]\u3001\u589e\u957f20%\uff0c\u8425\u4e1a\u6536\u5165[[se_east_rev|1100\u4ebf\u5143]]\u3001\u589e\u957f10%\uff1b\u897f\u90e8\u4f01\u4e1a[[se_west|1800\u5bb6]]\u3001\u589e\u957f20%\uff0c\u8425\u4e1a\u6536\u5165[[se_west_rev|800\u4ebf\u5143]]\u3001\u589e\u957f60%\uff1b\u5317\u90e8\u4f01\u4e1a[[se_north|1800\u5bb6]]\u3001\u589e\u957f80%\uff0c\u8425\u4e1a\u6536\u5165[[se_north_rev|900\u4ebf\u5143]]\u3001\u589e\u957f50%\u3002",
