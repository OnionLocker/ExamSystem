# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# 运行时自签证书（prod.js 自动生成，勿提交私钥）
server/certs/

# SQLite 题库与运行时辅助文件（含真题、个人作答，不入 git）
*.db
*.db-journal
*.db-wal
*.db-shm

# data/ 下均为运行时数据
data/*
!data/calendar/
!data/calendar/*.json

# 导入的批次图片（可能很大，不入 git）
public/q-images/*
!public/q-images/.gitkeep

# 批次内部的原始素材/一次性脚本（不入 git）
batches/*/_raw/

# Claude Code 本地配置（每个开发者各自的，不入 git）
.claude/

# 环境变量
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python 字节码（跑 scripts/ 里的脚本时生成）
__pycache__/
*.pyc
