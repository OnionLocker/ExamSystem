# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# 数据库运行时辅助文件（WAL/SHM/journal 不入 git）
*.db-journal
*.db-wal
*.db-shm

# 默认忽略 data/ 目录里其它文件，但放行主数据库快照（含题库 + 个人练习记录）
data/*
!data/exam.db

# 导入的批次图片（可能很大，不入 git）
public/q-images/*
!public/q-images/.gitkeep

# 批次内部的原始素材/一次性脚本（不入 git）
batches/*/_raw/

# Claude Code 本地配置（每个开发者各自的，不入 git）
.claude/

# 环境变量
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python 字节码（跑 scripts/ 里的脚本时生成）
__pycache__/
*.pyc
