EXAM_PASSWORD=change-me-to-your-own-password
PORT=3001

HERMES_SESSION_TOKEN=change-me-random-string
HERMES_HOST=127.0.0.1
HERMES_PORT=9119

# CLIPROXY / Gemini（只读环境变量，不要把真密钥写入仓库或提交 .env）
# CLIPROXY_API_KEY=
# CLIPROXY_BASE_URL=http://127.0.0.1:8889/v1

# 统一模型路由（Model Router）
# ===========================
# 系统所有模型（Hermes 对话、出题、审核、资料分析、录屏复盘、语音、图片）
# 现在统一从 ~/.hermes/model-router.json 的 active profile 读取，前端「模型」页签可切换。
# 各模型的 API key 放在 ~/.hermes/.env：
#   CLIPROXY_API_KEY=...        # gemini-cliproxy（cliproxy 中转，支持视觉/语音）
#   DEEPSEEK_API_KEY=...        # deepseek（官方 https://api.deepseek.com，无视觉/语音）
#   OPENAI_API_KEY=...          # highway-gpt（gpt-5.5-r）
# 切换只改 router.json 的 active；config.yaml 由 server 自动同步（key_env 引用，不落明文）。
# 旧的按用途覆盖变量仍保留（显式设置时优先）：
# ZILIAO_GEMINI_MODEL=gemini-3.8-flash-high
# DAILY_GEMINI_MODEL=gemini-3.8-flash-high
# QUIZ_LITE_MODEL=gemini-3.8-flash-high
# CLIPROXY_PDF_MODEL=gemini-3.7-flash-high
